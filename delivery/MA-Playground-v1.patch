+
+/** Section samples split at a genuine puncture, never joined across it. */
+export function surfaceSection(s, domain, count = 150) {
+  const isLimit = s.lab === 'limits';
+  const punctured = isLimit && s.path === 'parabola' && s.k !== 0;
