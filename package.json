{
  "name": "ma-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive, proof-aware multivariable calculus experiments. 数学分析我爱你～",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs --port 5173",
    "start": "node scripts/serve.mjs --port 5173",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dir dist --port 4173",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "python tests/browser_test.py",
    "verify": "npm run check && npm test && npm run build"
  },
